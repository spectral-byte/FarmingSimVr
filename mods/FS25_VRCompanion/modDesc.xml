    <actions>
        <action name="VR_RECENTER_VIEW" category="ONFOOT VEHICLE"/>
        <action name="VR_HUD_TOGGLE" category="ONFOOT VEHICLE"/>
        <action name="VR_SNAP_TURN_LEFT" category="ONFOOT VEHICLE"/>
        <action name="VR_SNAP_TURN_RIGHT" category="ONFOOT VEHICLE"/>
        <action name="VR_TOGGLE_VIEW" category="ONFOOT VEHICLE"/>
    </actions>
    <inputBinding>
        <actionBinding action="VR_RECENTER_VIEW">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_numPad5"/>
            <binding device="GAMEPAD_DEFAULT" input="BUTTON_11"/>
        </actionBinding>
        <actionBinding action="VR_HUD_TOGGLE">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_rctrl KEY_h"/>
            <binding device="GAMEPAD_DEFAULT" input="BUTTON_10"/>
        </actionBinding>
        <actionBinding action="VR_SNAP_TURN_LEFT">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_numPad4"/>
            <binding device="GAMEPAD_DEFAULT" input="BUTTON_5"/>
        </actionBinding>
        <actionBinding action="VR_SNAP_TURN_RIGHT">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_numPad6"/>
            <binding device="GAMEPAD_DEFAULT" input="BUTTON_6"/>
        </actionBinding>
        <actionBinding action="VR_TOGGLE_VIEW">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_rctrl KEY_v"/>
            <binding device="KB_MOUSE_DEFAULT" input="KEY_numPad0"/>
            <binding device="GAMEPAD_DEFAULT" input="BUTTON_9"/>
        </actionBinding>
    </inputBinding>
</modDesc>
