<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="105">
    <author>spectral-byte</author>
    <version>1.0.0.0</version>
    <title>
        <en>FS25 VR Companion Mod</en>
        <de>FS25 VR Begleit-Mod</de>
    </title>
    <description>
<en><![CDATA[In-engine Luau Companion Mod for Farming Simulator 25 Virtual Reality.
Interfaces directly with the native Injector via the in-process VRBridge table,
coordinating head tracking, camera orientation, and stereoscopic rendering.

Virtual Hand model: "Gloved Hand" by J-Toastie (https://poly.pizza/m/MTB4egc4Vh),
CC BY 3.0 (https://creativecommons.org/licenses/by/3.0/), modified: scaled, rigged and mirrored.]]>
</en>
    </description>
    <multiplayer supported="true"/>
    <iconFilename>icon_vr.png</iconFilename>
    <extraSourceFiles>
        <sourceFile filename="src/VRCompanionConfig.lua"/>
        <sourceFile filename="src/VRCompanionCore.lua"/>
        <sourceFile filename="src/VRCompanionStereo.lua"/>
        <sourceFile filename="src/VRCompanionLocomotion.lua"/>
        <sourceFile filename="src/VRCompanionHud.lua"/>
        <sourceFile filename="src/VRCompanionInput.lua"/>
        <sourceFile filename="src/VRCompanionMotionControllers.lua"/>
        <sourceFile filename="src/VRCompanionMenuPointer.lua"/>
        <sourceFile filename="src/VRCompanionVirtualHands.lua"/>
        <sourceFile filename="src/VRCompanionWheelGrab.lua"/>
        <sourceFile filename="src/VRCompanionVirtualGamepad.lua"/>
        <sourceFile filename="src/VRCompanionHandTools.lua"/>
        <sourceFile filename="src/VRCompanionDialogProbe.lua"/>
        <sourceFile filename="src/VRCompanionFishCatch.lua"/>
        <sourceFile filename="src/VRCompanionInteractiveControl.lua"/>
        <sourceFile filename="src/VRCompanion.lua"/>
    </extraSourceFiles>
    <l10n>
        <text name="input_VR_RECENTER_VIEW">
            <en>Recenter VR View</en>
            <de>VR-Ansicht zentrieren</de>
        </text>
        <text name="input_VR_HUD_TOGGLE">
            <en>Toggle VR HUD Mode</en>
            <de>VR-HUD-Modus umschalten</de>
        </text>
        <text name="input_VR_SNAP_TURN_LEFT">
            <en>VR Snap Turn Left</en>
            <de>VR-Blickdrehung links</de>
        </text>
        <text name="input_VR_SNAP_TURN_RIGHT">
            <en>VR Snap Turn Right</en>
            <de>VR-Blickdrehung rechts</de>
        </text>
        <text name="input_VR_TOGGLE_VIEW">
            <en>Toggle VR View Mode</en>
            <de>VR-Ansichtsmodus umschalten</de>
        </text>
        <text name="vrHandTools_markerType">
            <en>Marker type: %s</en>
            <de>Markierungstyp: %s</de>
        </text>
        <text name="setting_vrHudConvergenceDepth">
            <en>VR HUD Convergence Depth (Meters)</en>
            <de>VR-HUD Konvergenztiefe (Meter)</de>
        </text>
        <text name="setting_vrShowHudLoadNotification">
            <en>Show VR HUD Map Load Alert</en>
            <de>VR-HUD Kartenladehinweis anzeigen</de>
        </text>
        <text name="setting_recenterVrTrackingSpace">
            <en>Recenter VR Tracking Space upon Recenter</en>
