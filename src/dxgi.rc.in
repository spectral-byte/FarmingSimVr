// Version resource of the Injector (dxgi.dll). configure_file() fills in the version from the
// Companion Mod's modDesc.xml, so the Injector and the release carry the same number.
//
// The Installer (installer/fs25_vr.iss) recognises an Injector of ours, to overwrite it without
// treating it as a foreign dxgi.dll such as ReShade, by ProductName "FS25 VR" below. Do not change it
// without changing IsOurInjector in the Installer script too.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @FS25VR_VERSION_COMMA@
 PRODUCTVERSION @FS25VR_VERSION_COMMA@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FS25 VR"
            VALUE "FileDescription", "FS25 VR Injector"
            VALUE "FileVersion", "@FS25VR_VERSION@"
            VALUE "InternalName", "dxgi"
            VALUE "OriginalFilename", "dxgi.dll"
            VALUE "ProductName", "FS25 VR"
            VALUE "ProductVersion", "@FS25VR_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
